            "vm_name": "{{ user `template` }}",
            "qemuargs": [
                [
                    "-m",
                    "{{ user `memory` }}"
                ],
                [
                    "-display",
                    "{{ user `qemu_display` }}"
                ]
            ]
        }
    ],
    "post-processors": [
        {
            "output": "{{ user `build_directory` }}/{{user `box_basename`}}.{{.Provider}}.box",
            "except": [
                "qemu"
            ],
            "type": "vagrant"
        }
    ],
    "provisioners": [
        {
            "environment_vars": [
                "KUBEADM_INSTALL={{ user `kubeadm_install`}}",
                "DOCKER_PKG={{ user `DOCKER_PKG`}}",
                "DOCKER_COMPOSE_PKG={{ user `DOCKER_COMPOSE_PKG`}}",
