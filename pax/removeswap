#!/bin/sh -eux

commenter () {
  COMMENT_THIS_LINE=$1
  FILE_TO_COMMENT=$2
  sed -i "s%^$COMMENT_THIS_LINE%#$COMMENT_THIS_LINE%" $FILE_TO_COMMENT
}

commenter '/dev/sr0' /etc/fstab
commenter '/dev/fd0' /etc/fstab
commenter '/dev/mapper/centos-swap' /etc/fstab
commenter '/dev/mapper/vagrant--vg-swap_1' /etc/fstab
commenter '/dev/mapper/debian--9--vg-swap_1' /etc/fstab

# Any other swap entry, whatever backs it: the list above
# predates swap by UUID and swap files (Ubuntu's /swap.img),
# and the kubelet refuses to start with swap on. Comment
# every fstab line whose filesystem type is swap, and drop
# the standard swap file if one was created.
sed -i -E 's|^([^#][^[:space:]]*[[:space:]]+[^[:space:]]*[[:space:]]+swap[[:space:]].*)$|#\1|' /etc/fstab
rm -f /swap.img
